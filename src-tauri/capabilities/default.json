{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the local card editor window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://auth.openai.com/oauth/authorize*" },
        { "url": "https://auth.openai.com/codex/device*" }
      ]
    },
    "process:default",
    "updater:default"
  ]
}
