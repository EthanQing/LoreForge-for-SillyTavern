{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SillyTavern Card Creator",
  "version": "0.1.2",
  "identifier": "com.local.sillytavern-card-creator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SillyTavern Card Creator",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMTIzM0RFMEQyMzg1MUIKUldRYmhTTU4zak1TaTM3Y05KanNpVlZiaDVMZ2tQZlBtdVJnZHlBRUI5Y2VNNGhsaE1xM0hTWS8K",
      "endpoints": [
        "https://github.com/EthanQing/Sillytavern-Card-Creator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
