{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SillyTavern Card Creator",
  "version": "0.1.0",
  "identifier": "com.local.sillytavern-card-creator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SillyTavern Card Creator",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
